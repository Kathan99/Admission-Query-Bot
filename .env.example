GEMINI_API_KEY="your_gemini_api_key_here"

# Bearer token — required on all /chat and /api/admin/* requests
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BEARER_TOKEN="your-secure-bearer-token-here"
GEMINI_MODEL="gemini-3-flash-preview"          # main generation model
GEMINI_LITE_MODEL="gemini-3-flash-preview"     # lightweight tasks (HyDE, contextualize)
EMBEDDING_MODEL="all-MiniLM-L6-v2"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# AWS S3 — set USE_S3=true and fill in credentials for production PDF storage
USE_S3=false
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
S3_BUCKET="your-s3-bucket-name"
S3_PREFIX="pdfs/"

# OCR Ingestion Tuning
# ENABLE_OCR_FALLBACK=false  # Set to false to disable OCR completely for pure digital PDFs
OCR_THREADS="4"            # Number of parallel workers for scanned-page OCR
OCR_SCALE="2.0"            # Render scale before OCR (2.0 gives ~300 DPI equivalent)

# MongoDB Atlas — query & answer logging for debugging
# Get your URI from: https://cloud.mongodb.com → Connect → Drivers → Python
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="rag_chatbot"              # Atlas database name
MONGODB_COLLECTION="query_logs"      # Collection that stores each chat turn
ENABLE_MONGO_LOGGING=true            # Set to false to disable silently
